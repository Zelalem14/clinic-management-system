# Backend Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Persistent MySQL for Production)
# Option A (Recommended for Cloud Providers like TiDB Cloud, Aiven, Railway):
# DATABASE_URL=mysql://<username>:<password>@<host>:<port>/<dbname>?ssl={"rejectUnauthorized":true}

# Option B (Separate Host/User/Pass):
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinic_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_SSL=false
DB_LOGGING=false

# Security & JWT Configuration
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRES_IN=24h

# Allowed CORS Frontend URL (comma-separated if multiple, e.g. https://my-clinic.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Auto-seed initial clinic data on startup (true will seed demo Ethiopian clinic dataset if DB is fresh)
AUTO_SEED=false

# Frontend Configuration (for Vercel)
# VITE_API_URL=https://<your-backend-app>.onrender.com/api
