# ==============================================================================
# Clinic Management System - Environment Configuration
# ==============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Choose One Option Below)
# ------------------------------------------------------------------------------

# OPTION 1: Free Cloud PostgreSQL or MySQL (Recommended for Vercel / Render / Cloud)
# Connects permanently to any managed cloud database: Render PostgreSQL, Supabase, Neon, Railway, TiDB
# DATABASE_URL=postgres://username:password@ep-host.region.provider.com:5432/clinic_db?sslmode=require
# DATABASE_URL=mysql://username:password@gateway.provider.com:3306/clinic_db

# OPTION 2: PostgreSQL (Local or Remote with separate credentials)
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=clinic_db
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_SSL=false

# OPTION 3: MySQL (Local or Remote with separate credentials)
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=clinic_db
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_SSL=false

# OPTION 4: Persistent SQLite (Default for Local Workstation & Persistent Docker Volumes)
# Stores data permanently in the clinic database file with WAL durability mode
DB_DIALECT=sqlite
# Optional custom storage file location (e.g. /var/data/clinic.sqlite on persistent Render disk):
# DB_STORAGE=../database/clinic.sqlite
DB_LOGGING=false

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
JWT_SECRET=clinic_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# Allowed CORS Frontend URLs (comma-separated for multi-device & production)
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173,https://clinic-management-system-ever-4048.vercel.app

# ------------------------------------------------------------------------------
# Seeding
# ------------------------------------------------------------------------------
AUTO_SEED=false
