# Server Configuration
PORT=5000
NODE_ENV=development

# Database Dialect: 'mysql' (standard production) or 'sqlite' (local development)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinic_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_LOGGING=false

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Client URL
CLIENT_URL=http://localhost:5173

# Auto-seed initial demo dataset
AUTO_SEED=false
