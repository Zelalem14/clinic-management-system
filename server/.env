# Server Configuration
PORT=5000
NODE_ENV=development

# Database Dialect: 'sqlite' or 'mysql'
# Set to 'mysql' when connecting to a local/remote MySQL instance
DB_DIALECT=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinic_db
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# JWT Secret
JWT_SECRET=clinic_super_secret_jwt_key_2026
JWT_EXPIRES_IN=24h

# CORS Frontend URL
CLIENT_URL=http://localhost:5173

# Auto-seed on startup (set true if you want auto-initialization of demo accounts)
AUTO_SEED=false
