{
  "name": "clinic-management-system",
  "version": "1.0.0",
  "description": "Full-Stack Responsive Clinic Management System with Node.js, Express, Sequelize ORM, MySQL/SQLite, and React + Tailwind CSS",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "server:seed": "npm --prefix server run seed",
    "server:test": "npm --prefix server test",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  },
  "keywords": [
    "clinic",
    "hospital",
    "react",
    "express",
    "sequelize",
    "mysql",
    "healthcare"
  ],
  "author": "Clinic Management Development Team",
  "license": "MIT"
}
